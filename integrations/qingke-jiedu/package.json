    "check": "npm run lint && npm test",
    "smoke:web": "node web/smoke.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@napi-rs/canvas": "^1.0.7",
    "adm-zip": "^0.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsdom": "^29.1.1",
    "multer": "^2.2.0",
    "pdfjs-dist": "^6.2.108",
    "puppeteer-core": "^25.8.0"
  },
  "devDependencies": {
    "oxlint": "^1.87.0"
  }
}
