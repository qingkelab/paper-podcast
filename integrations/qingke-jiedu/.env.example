# ===== 青稞解读 配置示例 =====
# 复制为 .env 后填写；未配置 key 时文案生成会明确报错（不再有示例文案）。

PORT=4780
HOST=127.0.0.1

# ---- 文案引擎 ----
# 可选值：deepseek | openai | ollama
LLM_PROVIDER=deepseek

# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# OpenAI（或任意 OpenAI-compatible 端点）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ollama（本地模型，无需 key；先 `ollama serve` 并 `ollama pull <model>`）
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ---- 渲染 ----
# MAX_PDF_PAGES=30        # PDF 最多转图页数
# PDF_SCALE=2             # PDF 渲染清晰度
# WEB_VIEWPORT_WIDTH=1280
# WEB_DEVICE_SCALE=2
# WEB_SEGMENT_HEIGHT=4000 # 长网页分段高度（CSS 像素）

# ---- 文案约束 ----
# MAX_COPY_CHARS=1000     # 解读文案字数上限
# MAX_TITLE_CHARS=20      # 标题字数上限

# ---- 同步到公众号（可选，需认证服务号，支持多账号 + 主题配色）----
# 账号1：
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_NAME=公众号1
WECHAT_THEME=orange        # orange 橘色 | blue 经典蓝
# 账号2（多个账号依次加 2/3/4...）：
# WECHAT2_APP_ID=
# WECHAT2_APP_SECRET=
# WECHAT2_NAME=公众号2
# WECHAT2_THEME=blue

# ---- 论文视频播客（🎙️ 论文播客 模式）----
# 写稿模型沿用上方 LLM_PROVIDER / DEEPSEEK_API_KEY / OLLAMA_* 配置
# 配音引擎：auto = 有 MINIMAX_API_KEY 用 MiniMax（speech-02-hd 高保真），否则用 edge-tts（免费，需本机已安装）
TTS_ENGINE=auto
TTS_RATE=+8%            # 语速（edge 风格："+8%" 稍快）
# MINIMAX_API_KEY=       # 填入后自动启用 MiniMax 高保真配音
# TTS_VOICE=             # 缺省按引擎取默认音色（Edge：zh-CN-YunxiNeural / MiniMax：male-qn-qingse）
# 时长档位与画面（可选）：PODCAST_MAX_SECONDS=310（超过自动加速重录）
# VIDEO_WIDTH=1920 / VIDEO_HEIGHT=1080 / XFADE_SECONDS=0.6
