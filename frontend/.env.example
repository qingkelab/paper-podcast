# 复制成 .env 或 .env.local 后按需修改；也可以直接写成命令行环境变量。

# 1 = 纯浏览器离线 Mock 模式（不访问任何后端，用于 GitHub Pages 演示）
# 0 或留空 = 真实后端模式（请求 /api，开发态由 Vite proxy 转发到 http://127.0.0.1:8000）
VITE_USE_MOCK=0

# 快速图文工具地址。合并开发脚本会自动指向本地 4781 端口；独立构建或部署时，
# 请设置为可从用户浏览器访问的青稞解读服务地址（含协议和端口）。
VITE_QINGKE_JIEDU_URL=http://127.0.0.1:4781/
