# ==========================================================================
# 论文解读 AI 播客 —— 环境变量模板
#
# 用法：cp .env.example .env 然后把密钥填进去。
# 不填任何密钥也能启动：系统会自动降级为 Mock 模式，全流程可跑通（音频是占位音）。
# ==========================================================================

# ---------- 基础 ----------
# 前端开发服务器地址，后端只允许这些来源跨域访问
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ---------- 文本解读 / 播客脚本的大模型 ----------
# 提供方：auto（谁配了密钥用谁，DeepSeek 优先）/ deepseek / doubao
LLM_PROVIDER=auto

# 【当前使用】DeepSeek —— https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 【备选】豆包方舟 —— 火山引擎控制台 → 方舟 → API Key
ARK_API_KEY=
# 接入点 ID（ep-xxxxxxxx）或模型 ID（如 doubao-seed-1-6-250615）
ARK_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---------- 豆包语音播客（音频合成）----------
# 两套鉴权任选其一：
#
# 【推荐】新版 API Key 鉴权
DOUBAO_API_KEY=
#
# 【旧版】AK/SK 鉴权（三个都要填）
DOUBAO_APP_ID=
DOUBAO_ACCESS_KEY=
# 播客接口的固定 app key，通常不需要改
DOUBAO_APP_KEY=aGjiRDfUWi

# 播客合成 WebSocket 地址与资源 ID（一般不需要改）
PODCAST_WS_URL=wss://openspeech.bytedance.com/api/v3/sami/podcasttts
PODCAST_RESOURCE_ID=volc.service_type.10050

# ---------- 片头 / 片尾 ----------
# 服务端自带的片头片尾音乐：默认关掉（罐头音乐放在社区播客里品牌感是乱的）
PODCAST_HEAD_MUSIC=false
PODCAST_TAIL_MUSIC=false
# 每期自动加上社区品牌话术（文案与设计说明见 backend/app/branding.py）
ENABLE_BRAND_INTRO_OUTRO=true

# ---------- 默认音色 ----------
DEFAULT_VOICE_A=zh_male_dayixiansheng_v2_saturn_bigtts
DEFAULT_VOICE_B=zh_female_mizaitongxue_v2_saturn_bigtts
# 英文版的默认音色（英文版不能用中文音色：虽然也能出声，但口音很明显）
DEFAULT_VOICE_A_EN=en_male_alex_uranus_bigtts
DEFAULT_VOICE_B_EN=en_female_jenny_uranus_bigtts

# ---------- 语言版本 ----------
# 主语言：详情页默认展示、不带 ?lang= 时取用的那一版
DEFAULT_LANGUAGE=zh
# 每期默认产出哪些语言版本，逗号分隔。
# 填 zh,en 就是每期同时出中英两版 —— 解读与脚本各调两次模型、
# 音频合成跑两遍，**成本与耗时大致翻倍**（视频也会各编一遍）。
LANGUAGES=zh

# ---------- 账号（V2）----------
# 注册邀请码。留空 = 开放注册；设了就必填且必须一致。
# 公开部署时这是挡住陌生人的第一道门 —— 比「每天限次数」直接。
SIGNUP_CODE=

# 会话有效期（天）
SESSION_TTL_DAYS=30

# 会话 cookie 是否只在 HTTPS 下发送。
# 本地 http 调试必须保持 false（true 的话 cookie 根本存不下，会一直登不上）；
# 生产环境有域名 + 证书时改成 true。
COOKIE_SECURE=false

# 单次批量生成的论文数上限
MAX_BATCH_SIZE=20

# 登录限流：同一「用户名 + 来源 IP」失败多少次后暂时锁住，锁多久（分钟）。
# 没有它，登录接口就是一个可以无限次尝试的口令爆破入口。
# 注意是**进程内内存**实现：多实例部署要换成 Redis / 数据库表。
LOGIN_MAX_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# 每个账号 24 小时内最多能发起多少次生成（0 = 不限）。
# 一次生成要调大模型 + 语音合成 + 视频编码，是真金白银 ——
# 有了多账号之后，不给上限就等于把账单交给任何注册进来的人。
# 窗口是「最近 24 小时」的滑动窗口；批量按篇数扣。
DAILY_GENERATION_LIMIT=30

# ---------- 行为开关 ----------
# 强制使用 Mock（即使填了密钥），用于本地联调前端
FORCE_MOCK=false
# 后台 worker 并发数。建议保持 1，避免触发豆包 API 并发限流
WORKER_CONCURRENCY=1
# 单篇论文送入模型的文本上限（字符）
MAX_PAPER_CHARS=20000
# 失败自动重试次数
MAX_RETRIES=2

# 是否在音频合成后继续合成视频解读播客（需要系统安装 ffmpeg）
# 关掉可以省掉最后一步编码时间
ENABLE_VIDEO=true

# 自动把「整体转了 90°/180°」的论文配图摆正（判定保守，只有极少数图会命中）
AUTO_UPRIGHT_FIGURES=true

# 视频里「没有对应论文原图」的段落，最多现场生成几张专门配图。
# 每张一次模型调用（实测约 10 秒），调大要留意成本与耗时；0 表示不生成。
MAX_TOPIC_IMAGES=4
